{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "couple": {
      "type": "object",
      "properties": {
        "groom": {
          "type": "string",
          "description": "新郎姓名"
        },
        "bride": {
          "type": "string",
          "description": "新娘姓名"
        },
        "groomEn": {
          "type": "string",
          "description": "新郎英文名或拼音"
        },
        "brideEn": {
          "type": "string",
          "description": "新娘英文名或拼音"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "婚礼日期"
        },
        "tagline": {
          "type": "string",
          "description": "主标题"
        }
      },
      "required": [
        "groom",
        "bride",
        "groomEn",
        "brideEn",
        "date",
        "tagline"
      ]
    },
    "photos": {
      "type": "object",
      "properties": {
        "kidGroom": {
          "type": "string",
          "minLength": 1
        },
        "kidBride": {
          "type": "string",
          "minLength": 1
        },
        "childhood": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "first": {
          "type": "string",
          "minLength": 1
        },
        "dating": {
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dating2": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wedding": {
          "type": "string",
          "minLength": 1
        },
        "pairs": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trio": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closing": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kidGroom",
        "kidBride",
        "childhood",
        "first",
        "dating",
        "dating2",
        "wedding",
        "pairs",
        "trio",
        "closing"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {
        "welcome_1": {
          "type": "string",
          "description": "开场 · 第一行打字"
        },
        "welcome_2": {
          "type": "string",
          "description": "开场 · 第二行打字"
        },
        "groom_label": {
          "type": "string",
          "description": "童年页 · 新郎称呼"
        },
        "bride_label": {
          "type": "string",
          "description": "童年页 · 新娘称呼"
        },
        "born_prefix": {
          "type": "string",
          "description": "童年页 · 生日前缀"
        },
        "grow_title": {
          "type": "string",
          "description": "童年四图 · 标题"
        },
        "grow_lines": {
          "type": "string",
          "description": "童年四图 · 下方两行（用｜分隔）"
        },
        "met_line": {
          "type": "string",
          "description": "相遇页 · 日期下的一句"
        },
        "counter_head": {
          "type": "string",
          "description": "计数页 · 上方小字"
        },
        "counter_unit": {
          "type": "string",
          "description": "计数页 · 数字后的单位"
        },
        "hearts": {
          "type": "string",
          "description": "恋爱中段 · 打字一句（可用｜分两行）"
        },
        "today": {
          "type": "string",
          "description": "婚礼前 · 打字一句"
        },
        "quote": {
          "type": "string",
          "description": "结尾前 · 打字两行（用｜分隔）"
        },
        "thanks": {
          "type": "string",
          "description": "结尾 · 致谢两行（用｜分隔）"
        }
      },
      "required": [
        "welcome_1",
        "welcome_2",
        "groom_label",
        "bride_label",
        "born_prefix",
        "grow_title",
        "grow_lines",
        "met_line",
        "counter_head",
        "counter_unit",
        "hearts",
        "today",
        "quote",
        "thanks"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "beatGrid": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "beats": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "beats"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pace": {
      "type": "number",
      "minimum": 1,
      "maximum": 2,
      "description": "节奏：每页时长的倍数。1 为默认；1.5 让每页停留更久，全片随之变长"
    },
    "since": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "相遇或在一起的日期（YYYY-MM-DD）：相遇页显示它，计数页算到婚礼日期的天数"
    },
    "groomBorn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "新郎生日（YYYY-MM-DD），童年页显示"
    },
    "brideBorn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "新娘生日（YYYY-MM-DD），童年页显示"
    }
  },
  "required": [
    "couple",
    "photos",
    "copy",
    "music",
    "fps",
    "pace",
    "since",
    "groomBorn",
    "brideBorn"
  ]
}
